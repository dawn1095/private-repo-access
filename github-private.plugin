#!name = GitHub Private Repo Access
#!desc = 自动为 GitHub 私有仓库 Raw 请求添加 Token 认证
#!author = Dawn1095
#!icon = https://github.com/fluidicon.png
#!date = 2026-6-11

[General]
github_token = ghp_你的Token

[MITM]
hostname = raw.githubusercontent.com

[Script]
http-request https://raw\.githubusercontent\.com/.+ script-path=https://raw.githubusercontent.com/dawn1095/private-repo-access/refs/heads/main/github_auth.js, requires-body=false, timeout=10, tag=GitHub Private Repo Auth

