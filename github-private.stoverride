name: 'GitHub Private Repo Access'
desc: |-
  自动为 GitHub 私有仓库 Raw 请求添加 Token 认证。

  使用前：
  1. 将下方 http.script.argument 中的 github_token 替换为你的 GitHub
     Personal Access Token（需 repo 权限，占位符保持原样时脚本会弹窗提示）；
  2. 在 Stash 中安装并完全信任 CA 证书，并开启 MitM，否则脚本不会触发。
author: 'Dawn1095'
homepage: 'https://github.com/dawn1095/private-repo-access'
icon: 'https://github.com/fluidicon.png'
category: 'GitHub'
date: '2026-10-04'
version: '1.0.0'

http:
  # 仅解密 raw.githubusercontent.com，避免全局解密
  mitm:
    - raw.githubusercontent.com
  script:
    # 命中 raw.githubusercontent.com 的任意请求，注入 Authorization 头
    - match: ^https://raw\.githubusercontent\.com/.+
      name: 'GitHub Private Repo Auth'
      type: request
      # 仅改写请求头，无需读取请求体
      require-body: false
      timeout: 10
      # 与 github_auth.js 中的 PLACEHOLDER_TOKEN 保持一致：
      # 保持原样（未替换）时脚本判定为未配置并弹窗提示，不会伪装成已就绪
      argument: github_token=ghp_你的Token

script-providers:
  'GitHub Private Repo Auth':
    url: 'https://raw.githubusercontent.com/dawn1095/private-repo-access/refs/heads/main/github_auth.js'
    interval: 86400