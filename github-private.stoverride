name: 'GitHub Private Repo Access'
desc: |-
  自动为 GitHub 私有仓库 Raw 请求添加 Token 认证。

  订阅本文件即可生效：含 mitm、脚本触发项与脚本本体，公开文件零 Token。
  Token 只写 Stash 本机（见下方本地覆写注释）：$argument 为空时脚本回退
  读取本机 $persistentStore，皆空则仅弹窗提示、不注入请求头。
  需在 Stash 中安装并完全信任 CA 证书，并开启 MitM，否则脚本不会触发。
author: 'Dawn1095'
homepage: 'https://github.com/dawn1095/private-repo-access'
icon: 'https://github.com/fluidicon.png'
category: 'GitHub'
date: '2026-10-04'
version: '1.2.0'

http:
  # 仅解密 raw.githubusercontent.com，避免全局解密
  mitm:
    - raw.githubusercontent.com
  script:
    # 命中 raw.githubusercontent.com 的任意请求，注入 Authorization 头
    - match: ^https://raw\.githubusercontent\.com/.+
      name: 'GitHub Private Repo Auth'
      type: request
      # 仅改写请求头，无需读取请求体
      require-body: false
      timeout: 10
      # Token 只写 Stash 本机，绝不写进本公开文件：另建一个本地覆写，内容：
      #   http:
      #     script:
      #       - name: 'GitHub Private Repo Auth'
      #         argument: github_token=<你的Token>
      # 跨文件同名覆写合并 argument 后脚本的 $argument 即得 Token；首次运行后
      # 脚本经 $persistentStore 自动持久化，后续本地覆写即使删除也可继续生效。
      # 本公开文件的 argument 保持空字符串，绝不携带任何 Token。
      argument: ""

# 脚本本体：触发项以同名 name 引用（同一有效配置内闭环）
script-providers:
  'GitHub Private Repo Auth':
    url: 'https://raw.githubusercontent.com/dawn1095/private-repo-access/refs/heads/main/github_auth.js'
    interval: 86400
