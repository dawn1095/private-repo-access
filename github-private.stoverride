name: 'GitHub Private Repo Access'
desc: |-
  自动为 GitHub 私有仓库 Raw 请求添加 Token 认证（基础设施覆写，不含触发项与 Token）。

  本文件可放心订阅：只含 mitm 与脚本本体，不含 http.script 触发项，
  单独启用时不生效、不携带任何敏感信息。
  生效需另加一个设备本地覆写声明触发项并携带 Token
  （见仓库中的 github-private.token.stoverride.example）。
  需在 Stash 中安装并完全信任 CA 证书，并开启 MitM，否则脚本不会触发。
author: 'Dawn1095'
homepage: 'https://github.com/dawn1095/private-repo-access'
icon: 'https://github.com/fluidicon.png'
category: 'GitHub'
date: '2026-10-04'
version: '1.1.0'

http:
  # 仅解密 raw.githubusercontent.com，避免全局解密
  mitm:
    - raw.githubusercontent.com
  # 刻意不声明 http.script：Stash 覆写对数组采用前插合并，无法按元素修改；
  # 触发项（含 argument）只能由设备本地的另一个覆写声明，
  # Token 因此永远不会写入本公开文件。

# 脚本本体：由本地覆写的 http.script 以同名 name 引用
script-providers:
  'GitHub Private Repo Auth':
    url: 'https://raw.githubusercontent.com/dawn1095/private-repo-access/refs/heads/main/github_auth.js'
    interval: 86400
